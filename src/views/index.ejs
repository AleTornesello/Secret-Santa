<%- include('partials/head', { title: 'Make someone’s day' }) %>
<section class="hero"><p class="eyebrow">THE BEST GIFTS START WITH A LITTLE MYSTERY</p><h1>A name.<br>A secret.<br><em>A little magic.</em></h1><p class="intro">Bring your favorite people together. We’ll take care of who’s gifting whom.</p><div class="steps"><span><b>01</b> Make your list</span><span><b>02</b> Share the link</span><span><b>03</b> Reveal the surprise</span></div><div class="gift-art" aria-hidden="true"><span class="spark spark-one">✦</span><div class="gift"><div class="bow"></div><div class="gift-lid"></div><div class="gift-body"></div><div class="gift-ribbon"></div></div><span class="spark spark-two">✧</span><span class="gift-caption">a small act of thoughtfulness</span></div></section>
<section class="card create-card" aria-labelledby="create-title"><p class="eyebrow">LET’S GET EVERYONE TOGETHER</p><h2 id="create-title">Start your exchange</h2><p>You’re on the list, too. Add everyone taking part, then choose your name.</p><form method="post" action="/groups"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><label for="names">Who’s joining?</label><span class="field-hint" id="names-help">One name per line · 2–50 people · Include yourself</span><textarea id="names" name="names" rows="7" required aria-describedby="names-help" placeholder="Alex&#10;Sam&#10;Charlie&#10;You"></textarea><button class="button primary" type="submit">Create your group <span aria-hidden="true">↗</span></button></form><div class="card-note"><span aria-hidden="true">◷</span><span>Your group lasts one hour from creation. No accounts, no saved lists.</span></div></section>
<%- include('partials/foot') %>

