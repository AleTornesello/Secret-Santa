<%- include('partials/head', { title: state.status === 'DRAWN' ? 'Your secret is here' : 'Your exchange' }) %>
<section class="group-heading"><p class="eyebrow">A LITTLE MYSTERY, SHARED TOGETHER</p><h1 id="group-title"><%= state.status === 'DRAWN' ? 'The secret is out.' : 'Your people. Your exchange.' %></h1><p id="live-status" role="status" aria-live="polite">Connecting to your group…</p><p class="expiry">Group expires at <time id="deadline" datetime="<%= new Date(state.expiresAt).toISOString() %>"><%= new Date(state.expiresAt).toLocaleTimeString('en-GB', { timeZone: 'UTC' }) %> UTC</time></p></section>
<section class="card result-card" id="result-section" <%= state.recipient ? '' : 'hidden' %>><p class="eyebrow">JUST BETWEEN US</p><h2>You’re gifting to</h2><p class="recipient" data-testid="recipient" id="recipient"><%= state.recipient?.name ?? '' %></p><p>A thoughtful surprise starts here. Remember this name before the group expires.</p><span class="pill">One draw. Your secret to keep.</span></section>
<section class="card group-card" id="group-section"><div class="card-heading"><h2>Who’s here</h2><span class="pill" id="people-count"><%= state.participants.filter(p => p.connected).length %>/<%= state.participants.length %> connected</span></div><p id="identity-hint"><%= state.selfId ? 'Your name is selected. Wait here while everyone joins.' : state.status === 'DRAWN' ? 'This exchange has already been drawn.' : 'Select your own name to join the exchange.' %></p><input type="hidden" name="csrfToken" value="<%= csrfToken %>" id="csrf-token"><ul class="roster" id="roster">
<% for (const participant of state.participants) { %><li data-participant="<%= participant.id %>"><div><strong><%= participant.name %></strong><span class="person-status"><%= participant.id === state.selfId ? 'You · ' : '' %><%= participant.connected ? 'Connected' : participant.claimed ? 'Reconnecting' : 'Not joined yet' %></span></div><% if (state.status === 'WAITING' && !state.selfId && !participant.claimed) { %><form method="post" action="/groups/<%= state.code %>/claim"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="participantId" value="<%= participant.id %>"><button class="button small" type="submit">That’s me</button></form><% } %><% if (state.status === 'WAITING' && participant.claimed && (state.isCreator || state.selfId === participant.id)) { %><form method="post" action="/groups/<%= state.code %>/release"><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><input type="hidden" name="participantId" value="<%= participant.id %>"><button class="text-button" type="submit">Release name</button></form><% } %></li><% } %>
</ul><form method="post" action="/groups/<%= state.code %>/draw" id="draw-form" <%= state.isCreator && state.status === 'WAITING' ? '' : 'hidden' %>><input type="hidden" name="csrfToken" value="<%= csrfToken %>"><button type="submit" id="draw-button" class="button primary" <%= state.ready ? '' : 'disabled' %>>Reveal the names <span aria-hidden="true">✦</span></button><p class="field-hint">Everyone must select a name and stay connected. The draw is final.</p></form></section>
<section class="card invite-card" id="invite-section"><p class="eyebrow">THE MORE THOUGHTFUL, THE MERRIER</p><h2>Bring everyone in</h2><p>Send this link to the people on your list.</p><label class="sr-only" for="invite-link">Invitation link</label><input id="invite-link" value="<%= invite %>" readonly><button type="button" class="button secondary" id="copy-link">Copy invitation link</button><p id="copy-status" role="status"></p></section>
<section class="card" id="expired-section" hidden><h2>This group has expired</h2><p>Groups last one hour from creation. Your names and draw have been removed from the server.</p><a class="button primary" href="/">Start a new exchange</a></section>
<noscript><p class="notice">JavaScript is required for live connections and the draw. Please enable it and reload.</p></noscript><script id="group-data" type="application/json"><%- bootstrap %></script><script defer src="/assets/group.js"></script>
<%- include('partials/foot') %>

