{
  "name": "secret-santa",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @secret-santa/web dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @secret-santa/web e2e",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "stack:start": "supabase start -x studio,imgproxy,storage-api,logflare,vector,supavisor,postgres-meta,mailpit",
    "test:integration": "pnpm --filter @secret-santa/functions test:integration",
    "e2e:stack": "pnpm --filter @secret-santa/web e2e:stack"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "supabase": "3.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
